<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="pa-8 text-center">
                    <MudText Typo="Typo.h5" Color="Color.Error">Access Denied</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2 text-white">You are not authorized to view this resource with your current role.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/login">
                        Go to Login
                    </MudButton>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
