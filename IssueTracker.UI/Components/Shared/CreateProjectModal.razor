<MudDialog Style="background-color: #161922; border: 1px solid #282e40; border-radius: 12px; min-width: 450px;">
    <TitleContent>
        <div class="d-flex align-center gap-2 pt-2 pa-2">
            <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="fw-bold text-white">Create New Project</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string"
                          Label="Project Name"
                          @bind-Value="name"
                          Required="true"
                          RequiredError="Project Name is required"
                          Variant="Variant.Outlined"
                          Placeholder="e.g. Mobile App"
                          Class="mb-4" />

            <MudTextField T="string"
                          Label="Key Prefix (1-6 uppercase letters)"
                          @bind-Value="keyPrefix"
                          Required="true"
                          RequiredError="Key Prefix is required"
                          Variant="Variant.Outlined"
                          Placeholder="e.g. MOB"
                          Class="mb-4" />

            <MudTextField T="string"
                          Label="Description"
                          @bind-Value="description"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Placeholder="Brief summary of project scope..."
                          Class="mb-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Style="color: #94a3b8;" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Style="font-weight: 600; border-radius: 8px;"
                   OnClick="Submit"
                   Disabled="@(!success)">
            Create Project
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm form = default!;
    private bool success;

    private string name = string.Empty;
    private string keyPrefix = string.Empty;
    private string? description;

    private void Submit()
    {
        if (form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(new CreateProjectResult { Name = name, KeyPrefix = keyPrefix, Description = description }));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public class CreateProjectResult
    {
        public string Name { get; set; } = string.Empty;
        public string KeyPrefix { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
